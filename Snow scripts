-- Snow Scripts GUI + Hitbox Expander
-- LocalScript (StarterPlayer > StarterPlayerScripts)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "SnowScriptsGUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local main = Instance.new("Frame")
main.Size = UDim2.fromScale(0.25, 0.25)
main.Position = UDim2.fromScale(0.375, 0.35)
main.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
main.BackgroundTransparency = 0.15
main.Parent = gui
main.Active = true
main.Draggable = true
Instance.new("UICorner", main).CornerRadius = UDim.new(0, 16)

-- RGB Gradient
local grad = Instance.new("UIGradient", main)
task.spawn(function()
	while task.wait() do
		grad.Rotation += 1
	end
end)

-- Title
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0.25,0)
title.BackgroundTransparency = 1
title.Text = "❄ snow scripts ❄"
title.Font = Enum.Font.GothamBold
title.TextScaled = true
title.TextColor3 = Color3.fromRGB(255,255,255)
title.Parent = main

-- Hitbox Button
local hitboxOn = false
local btn = Instance.new("TextButton")
btn.Size = UDim2.fromScale(0.8, 0.3)
btn.Position = UDim2.fromScale(0.1, 0.55)
btn.Text = "Hitbox: OFF"
btn.Font = Enum.Font.GothamSemibold
btn.TextScaled = true
btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
btn.TextColor3 = Color3.fromRGB(255,255,255)
btn.Parent = main
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)

btn.MouseButton1Click:Connect(function()
	hitboxOn = not hitboxOn
	btn.Text = hitboxOn and "Hitbox: ON" or "Hitbox: OFF"
end)

-- Hitbox Logic
RunService.RenderStepped:Connect(function()
	if hitboxOn then
		for _,plr in pairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
				local hrp = plr.Character.HumanoidRootPart
				hrp.Size = Vector3.new(8,8,8)
				hrp.Transparency = 0.6
				hrp.BrickColor = BrickColor.new("Really red")
				hrp.Material = Enum.Material.Neon
				hrp.CanCollide = false
			end
		end
	end
end)

-- Snow Effect
for i = 1, 25 do
	task.spawn(function()
		while task.wait(math.random(1,3)/10) do
			local snow = Instance.new("TextLabel")
			snow.Text = "❄"
			snow.Font = Enum.Font.Gotham
			snow.TextScaled = true
			snow.TextColor3 = Color3.fromRGB(255,255,255)
			snow.BackgroundTransparency = 1
			snow.Size = UDim2.fromOffset(20,20)
			snow.Position = UDim2.fromScale(math.random(), -0.1)
			snow.Parent = main

			local tween = game:GetService("TweenService"):Create(
				snow,
				TweenInfo.new(math.random(3,6), Enum.EasingStyle.Linear),
				{Position = UDim2.fromScale(math.random(), 1.1)}
			)
			tween:Play()
			tween.Completed:Wait()
			snow:Destroy()
		end
	end)
end
